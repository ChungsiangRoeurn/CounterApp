<UserControl x:Class="CounterApp.Views.OverviewView"
             xmlns:conv="clr-namespace:CounterApp.Converters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <conv:ImageConverter x:Key="ImageConverter"/>
        <!-- Shared style for all stat cards -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Header -->
            <TextBlock Text="Overview"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="#333333"/>

            <TextBlock Text="Welcome to Movie Dashboard"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="2,2,0,20"/>

            <!-- Statistics -->
            <WrapPanel>

                <Border Style="{StaticResource StatCard}" Background="#FFF3E0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Movies Loaded" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="0" Style="{StaticResource StatValue}" Foreground="#E07B00"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Favorites" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="0" Style="{StaticResource StatValue}" Foreground="#D81B60"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Trending" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="0" Style="{StaticResource StatValue}" Foreground="#1E88E5"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Top Rated" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="0" Style="{StaticResource StatValue}" Foreground="#43A047"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <TextBlock Text="Recently Added"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Margin="0,10,0,12"/>

            <ItemsControl ItemsSource="{Binding RecentMovies}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150"
                                Height="220"
                                Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0,0,16,16">

                            <StackPanel>
                                <!-- Poster placeholder -->
                                <Image Height="140"
                                       Stretch="Fill"
                                       Source="{Binding PosterUrl, Converter={StaticResource ImageConverter}}"/>

                                <StackPanel Margin="10,8,10,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Year}"
                                                   FontSize="12"
                                                   Foreground="Gray"/>
                                        <TextBlock Text=" • " FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="Movie"
                                                   FontSize="12"
                                                   Foreground="#E07B00"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>

</UserControl>